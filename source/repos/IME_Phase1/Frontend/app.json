
{
  "expo": {
    "name": "IME App",
    "slug": "imeapp",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/IMEicon.png",

    "scheme": "imeapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ime.app"
    },

    "android": {
      "package": "org.ime.app",
      "versionCode": 2,

      "adaptiveIcon": {
        "foregroundImage": "./assets/IMEicon.png",
        "backgroundColor": "#1E3A5F"
      },

      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker"
    ],

    "extra": {
      "eas": {
        "projectId": "768dcb77-eeec-4f04-b64e-3c21cbc2a79d"
      }
    }
  }

}