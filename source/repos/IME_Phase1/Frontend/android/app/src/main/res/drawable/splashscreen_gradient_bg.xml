<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash screen background — diagonal duo-tone gradient echoing the IME
  crest's own palette: warm gold (top-left, matches the crest's gold arc)
  fading into cool blue-gray (bottom-right, matches the crest's Royal Blue).
  A vector gradient (not a raster image) so it stays perfectly crisp at
  every screen size/density with zero blur.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
      android:type="linear"
      android:angle="315"
      android:startColor="#FBF6EA"
      android:centerColor="#F1F1F0"
      android:endColor="#E7EEF7" />
</shape>
